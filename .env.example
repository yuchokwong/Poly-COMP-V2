# Copy to .env and edit. Values here override configs/default.yaml.
# Nested keys use a double underscore, e.g. TSR_APP__PORT -> app.port.

# --- Public domain (docker-compose.prod.yml + Caddy automatic HTTPS) ---
# Point an A record for this domain at the server's public IP first.
DOMAIN=search.example.com
ACME_EMAIL=you@example.com

TSR_APP__HOST=0.0.0.0
TSR_APP__PORT=8000
TSR_APP__DEFAULT_TOP_K=12
# Load all three strategies at startup instead of on the first request.
TSR_APP__PRELOAD_MODELS=true
# Torch thread count; defaults to the container's CPU quota/affinity.
# OMP_NUM_THREADS=4

# --- Shared CLIP backbone (image index + strategy A) ---
TSR_MODELS__CLIP__NAME=ViT-L-14
TSR_MODELS__CLIP__PRETRAINED=laion2b_s32b_b82k
TSR_MODELS__CLIP__DEVICE=auto      # auto | cpu | cuda
TSR_MODELS__CLIP__BATCH_SIZE=64

# --- Dense text encoder (strategies B and C) ---
TSR_MODELS__TEXT__NAME=BAAI/bge-small-en-v1.5
TSR_MODELS__TEXT__DEVICE=auto

# --- Offline VLM captioning (never loaded by the web server) ---
TSR_MODELS__VLM__BACKEND=qwen2_5_vl  # qwen2_5_vl | none
TSR_MODELS__VLM__MODEL=Qwen/Qwen2.5-VL-3B-Instruct
TSR_MODELS__VLM__DEVICE=auto

# --- Index: flat | hnsw | ivf | pq ---
TSR_INDEX__TYPE=flat

# --- Strategy weights (also editable in the UI at /api/settings) ---
TSR_STRATEGIES__CLIP_NLP__WEIGHTS__CLIP=0.5
TSR_STRATEGIES__CLIP_NLP__WEIGHTS__DOC=0.3
TSR_STRATEGIES__CLIP_NLP__WEIGHTS__BM25=0.2
TSR_STRATEGIES__VLM__CLIP_WEIGHT=0.2

# --- Dataset subset for a quick development loop (null = all 6,382) ---
TSR_DATASET__LIMIT=

# Docker build: choose the torch wheel index (CPU by default)
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
